# Copia a .env.local y ajusta. No subas secretos al repositorio.

# reCAPTCHA v3 — Site Key pública (la Secret Key vive solo en el backend)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Solo desarrollo local: omite cargar el script de Google y envía token dummy (backend debe tener RECAPTCHA_BYPASS_LOCAL=true)
NEXT_PUBLIC_RECAPTCHA_BYPASS_LOCAL=false
